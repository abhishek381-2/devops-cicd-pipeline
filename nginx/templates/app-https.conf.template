##############################################################################
# TLS (HTTPS) virtual host - TEMPLATE.
#
# Nginx does not expand ${VARIABLES} by itself. `scripts/setup-ssl.sh` renders
# this file on the EC2 host with `envsubst` and installs the result as
# nginx/conf.d/app-https.conf (replacing the plain-HTTP app.conf).
#
#   envsubst '${APP_DOMAIN}' < app-https.conf.template > app-https.conf
#
# Rendered output contains:
#   :80  -> 301 redirect to HTTPS  (+ ACME challenge kept on plain HTTP)
#   :443 -> TLS termination + reverse proxy to the Flask app
##############################################################################

upstream devops_cicd_app {
    server app:8000;
    keepalive 32;
}

# ---------------------------------------------------------------------------
# HTTP :80 -> redirect to HTTPS
# ---------------------------------------------------------------------------
server {
    listen      80;
    listen      [::]:80;
    server_name ${APP_DOMAIN};

    # Certbot's HTTP-01 renewal must stay on plain HTTP.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# HTTPS :443 -> reverse proxy
# ---------------------------------------------------------------------------
server {
    listen      443 ssl;
    listen      [::]:443 ssl;
    http2       on;
    server_name ${APP_DOMAIN};

    # --- TLS certificates (managed by Certbot) ------------------------------
    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;

    # --- Strong TLS configuration -------------------------------------------
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;
    ssl_stapling              on;
    ssl_stapling_verify       on;

    # --- Security headers ---------------------------------------------------
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options            "SAMEORIGIN"                      always;
    add_header X-Content-Type-Options     "nosniff"                         always;
    add_header X-XSS-Protection           "1; mode=block"                   always;
    add_header Referrer-Policy            "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy         "geolocation=(), microphone=(), camera=()" always;
    # The dashboard ships its own CSS/JS: no inline <script>, no eval and no
    # third-party origins. `style-src 'unsafe-inline'` is needed because the
    # chart renderer sets inline `style="width:..%"` attributes, and
    # `img-src data:` covers the inline SVG favicon.
    add_header Content-Security-Policy    "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'" always;

    # --- Static assets (dashboard CSS/JS) -----------------------------------
    location /static/ {
        proxy_pass         http://devops_cicd_app;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   Connection "";
        expires            1h;
        access_log         off;
    }

    # --- Reverse proxy ------------------------------------------------------
    location / {
        limit_req zone=api_limit burst=40 nodelay;

        proxy_pass         http://devops_cicd_app;
        proxy_http_version 1.1;

        # The Flask app also sets X-Content-Type-Options on every response.
        # Hide the upstream copy so the header is sent exactly once.
        proxy_hide_header  X-Content-Type-Options;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        proxy_set_header X-Request-ID      $request_id;
        proxy_set_header Connection        "";

        proxy_connect_timeout 10s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;

        proxy_intercept_errors on;
        error_page 502 503 504 /50x.html;
        location = /50x.html {
            root /usr/share/nginx/html;
            internal;
        }
    }

    location = /health {
        proxy_pass       http://devops_cicd_app;
        proxy_set_header Host $host;
        access_log off;
    }
}
