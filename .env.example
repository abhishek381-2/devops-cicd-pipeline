# =============================================================================
# Environment template - COPY to .env and adjust.  NEVER COMMIT .env
# =============================================================================
# cp .env.example .env
#
# On the EC2 server the equivalent file is /opt/devops-cicd/deploy/secrets.env
# (mode 0600, owned by the `deployer` user) and is NEVER part of the repository.
# =============================================================================

# --- Application identity ----------------------------------------------------
APP_NAME=devops-cicd-app
APP_VERSION=1.0.0
# development | testing | production
APP_ENV=development
APP_PORT=8000

# --- Flask ------------------------------------------------------------------
# Generate a strong value:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
FLASK_DEBUG=true

# --- Logging -----------------------------------------------------------------
# json  -> one JSON object per line (production)
# text  -> human readable (development)
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# --- Gunicorn ---------------------------------------------------------------
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50

# --- Database ----------------------------------------------------------------
# Either set DATABASE_URL directly, or leave it empty and configure the
# individual POSTGRES_* variables below (the app assembles the DSN itself).
DATABASE_URL=
POSTGRES_USER=appuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devops_cicd
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Health probe -----------------------------------------------------------
# Timeout (seconds) for the database probe inside /health.
HEALTH_DB_TIMEOUT=3.0

# --- Tests ------------------------------------------------------------------
# Point the test-suite at a real PostgreSQL instance (defaults to in-memory
# SQLite when unset).
TEST_DATABASE_URL=

# --- Connection pool ---------------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800

# --- Docker Compose ----------------------------------------------------------
# Image reference used by docker-compose.yml (development) and
# docker-compose.prod.yml (production, written by scripts/deploy.sh).
APP_IMAGE=devops-cicd-app
APP_TAG=local
# Host port for the development Nginx container.
NGINX_HTTP_PORT=8080

# --- Domain (production) -----------------------------------------------------
# Must match the DNS A record of the EC2 instance.
APP_DOMAIN=app.example.com

# --- Certbot (optional) ------------------------------------------------------
CERTBOT_EMAIL=admin@example.com
